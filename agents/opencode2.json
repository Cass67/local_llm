{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-llm-router/router",
  "providers": {
    "local-llm-router": {
      "name": "local-llm router",
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:3200/v1",
        "apiKey": "dummy-local-llm"
      },
      "models": {
        "router": {
          "name": "local-llm router",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  },
  "warming": false
}
