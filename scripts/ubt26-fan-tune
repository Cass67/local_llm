#!/usr/bin/env bash
set -euo pipefail
log(){ echo "[fan-tune] $*"; }

# Resolve a card by its PCI subsystem ID. cardN numbering does NOT follow the
# cards: on 2026-07-31 the Sapphire moved to the eGPU dock and kept the name
# card2, so a cardN-keyed script silently applied the Sapphire's constraints to
# the ASRock and left the Sapphire running free -- the config that kills the box.
card_by_subsys() {
  local want="$1" c d
  for c in /sys/class/drm/card[0-9]; do
    d="$c/device"
    [[ -e "$d/subsystem_device" ]] || continue
    if [[ "$(cat "$d/subsystem_vendor"):$(cat "$d/subsystem_device")" == "$want" ]]; then
      basename "$c"
      return 0
    fi
  done
  log "ERROR: no card with subsystem $want"
  return 1
}

SAPPHIRE_PULSE=0x1da2:0x471e
GIGABYTE_GAMING=0x1458:0x240c
ASROCK=0x1849:0x5308

# Write an OD scalar, commit it, read it back, retry. These files report their
# current value on line 2. Every setting here was previously written blind with
# "2>/dev/null || true", which is how the fan curve came out all zeros and the
# acoustic threshold sat at its 1750 default while the journal said "applied".
od_scalar() {
  local f="$1" want="$2" got=""
  [[ -e "$f" ]] || return 0
  for _ in 1 2 3; do
    echo "$want" > "$f" 2>/dev/null || true
    echo c > "$f" 2>/dev/null || true
    got=$(sed -n 2p "$f" 2>/dev/null)
    [[ "$got" == "$want" ]] && return 0
    sleep 1
  done
  log "ERROR: $(basename "$(dirname "$(dirname "$f")")")/$(basename "$f") = ${got:-unreadable}, wanted $want"
  return 1
}

apply_gpu_curve() {
  local card="$1" minpwm="$2" target="$3" acoustic="$4" p0="$5" p1="$6" p2="$7" p3="$8" p4="$9"
  local base="/sys/class/drm/${card}/device/gpu_od/fan_ctrl"
  [[ -d "$base" ]] || { log "$card no fan_ctrl"; return 0; }
  od_scalar "$base/fan_zero_rpm_enable" 0 || true
  od_scalar "$base/fan_zero_rpm_stop_temperature" 25 || true
  od_scalar "$base/fan_minimum_pwm" "$minpwm" || true
  od_scalar "$base/fan_target_temperature" "$target" || true
  od_scalar "$base/acoustic_target_rpm_threshold" "$acoustic" || true
  if [[ -e "$base/fan_curve" ]]; then
    echo r > "$base/fan_curve" 2>/dev/null || true
    local i pts=("$p0" "$p1" "$p2" "$p3" "$p4")
    for i in 0 1 2 3 4; do
      echo "$i ${pts[$i]}" > "$base/fan_curve" 2>/dev/null || true
    done
    echo c > "$base/fan_curve" 2>/dev/null || true
    # A curve that lands as all-zero points is not applied, whatever the writes
    # returned -- the firmware then falls back to target temp + acoustic limit.
    if grep -qE '^[0-4]: +0C +0%' "$base/fan_curve" 2>/dev/null; then
      log "WARNING: $card fan_curve did not take (all-zero points), running on target=${target}C acoustic=${acoustic}rpm"
    fi
  fi
  log "$card fan: target=$(sed -n 2p "$base/fan_target_temperature" 2>/dev/null)C acoustic=$(sed -n 2p "$base/acoustic_target_rpm_threshold" 2>/dev/null)rpm minpwm=$(sed -n 2p "$base/fan_minimum_pwm" 2>/dev/null)%"
}

# amdgpu rejects OD writes until the card finishes bringing up powerplay, so a
# boot-time run lands too early and every write silently no-ops.
wait_for_cards() {
  local deadline=$((SECONDS + 90)) c ready
  while ((SECONDS < deadline)); do
    ready=1
    for c in card0 card1 card2; do
      [[ -e "/sys/class/drm/$c/device/pp_dpm_mclk" ]] || ready=0
    done
    ((ready)) && { log "cards ready after ${SECONDS}s"; return 0; }
    sleep 2
  done
  log "WARNING: cards not ready after 90s, applying anyway"
}

# mode "eco": sclk DPM ceiling, 1900MHz OD cap, -75mV, PSU-sized power cap.
# mode "free": nothing held back — stock DPM, no OD, firmware-max power cap.
apply_card_eco() {
  local c="/sys/class/drm/$1/device" want_cap="$2" mode="${3:-eco}" uv="${4:--75}" cap
  [[ -d "$c" ]] || { log "$1 absent"; return 0; }
  # auto first, so any DPM mask a previous run left behind (the old mclk pin)
  # clears; then manual, which is the only mode that accepts OD and DPM writes.
  echo auto > "$c/power_dpm_force_performance_level" 2>/dev/null || true
  echo manual > "$c/power_dpm_force_performance_level" 2>/dev/null || true
  if [[ "$mode" == free ]]; then
    echo r > "$c/pp_od_clk_voltage" 2>/dev/null || true
    echo c > "$c/pp_od_clk_voltage" 2>/dev/null || true
  else
    echo 4 > "$c/pp_power_profile_mode" 2>/dev/null || true
    echo "0 1" > "$c/pp_dpm_sclk" 2>/dev/null || true
    # No mclk pin: on 6.19 the governor picks and holds level 3 under load by
    # itself, so pinning only suppressed idle downclock — ~44W per card of idle
    # draw, on the pair that shares the 850W supply, for nothing at load.
    echo "s 1 1900" > "$c/pp_od_clk_voltage" 2>/dev/null || true
    echo "vo $uv" > "$c/pp_od_clk_voltage" 2>/dev/null || true
    echo c > "$c/pp_od_clk_voltage" 2>/dev/null || true
  fi
  # Per-card cap. card0+card1 share the 850W Seasonic; card2 = 09:00.0 is the
  # OCuLink eGPU (the only card behind PCH root port 00:1b.0) on its own 800W.
  local floor
  for f in "$c"/hwmon/hwmon*/power1_cap; do
    [[ -e "$f" ]] || continue
    cap=$((want_cap * 1000000))
    # Below power1_cap_min the write returns EIO and the old cap silently stays,
    # so clamp: card1's BIOS floors at 253W and rejects the 238W in the old doc.
    floor=$(cat "${f}_min" 2>/dev/null || echo 0)
    ((cap < floor)) && cap=$floor
    [[ "$mode" == free ]] && cap=$(cat "${f}_max" 2>/dev/null || echo "$cap")
    echo "$cap" > "$f" 2>/dev/null || true
    cap=$(cat "$f" 2>/dev/null || echo 0)  # log what stuck, not what we asked for
  done
  # Hand the card back to stock DPM last: the writes above needed manual.
  [[ "$mode" == free ]] && { echo auto > "$c/power_dpm_force_performance_level" 2>/dev/null || true; }
  log "$1 $mode applied (mclk=$(grep -o '[0-9]*Mhz \*' "$c/pp_dpm_mclk" || echo unpinned) cap=$((${cap:-0} / 1000000))W)"
}

apply_hard_eco() {
  log "apply power tune"
  local sapphire gigabyte asrock
  sapphire=$(card_by_subsys "$SAPPHIRE_PULSE") || sapphire=""
  gigabyte=$(card_by_subsys "$GIGABYTE_GAMING") || gigabyte=""
  asrock=$(card_by_subsys "$ASROCK") || asrock=""
  log "cards: sapphire=${sapphire:-absent} gigabyte=${gigabyte:-absent} asrock=${asrock:-absent}"

  # The Sapphire Pulse is the card with the history -- five hard resets on
  # 2026-07-31, at idle, across both Seasonic PSU cables, whenever it ran free.
  # It stays constrained wherever it is plugged in, which is the point of keying
  # this by subsystem ID instead of cardN.
  [[ -n "$sapphire" ]] && apply_card_eco "$sapphire" 238 eco -75
  # Both of these have run free under sustained load without trouble.
  [[ -n "$gigabyte" ]] && apply_card_eco "$gigabyte" 0 free
  [[ -n "$asrock" ]] && apply_card_eco "$asrock" 0 free
}

wait_for_cards
apply_hard_eco
# Fans go LAST. free mode resets the OD table ("echo r > pp_od_clk_voltage"),
# and on these cards that wipes the fan_ctrl settings with it -- applying fans
# first logged target=65C acoustic=3000 and then read back as the per-card
# firmware defaults (81C/1400, 70C/1750, 80C/1400) seconds later.
# minpwm 20 keeps idle silent; target 65C and a 3000rpm acoustic ceiling let the
# firmware actually spin up, which it would not do at 70C/1750rpm -- card1 sat
# at 40% fan with its memory at 94C under load. The curve points are written
# too, but they have never stuck on these cards (logged as a WARNING).
apply_gpu_curve card0 20 65 3000 "25 25" "45 35" "60 50" "75 75" "85 100"
apply_gpu_curve card1 20 65 3000 "25 25" "45 35" "60 50" "75 75" "85 100"
apply_gpu_curve card2 20 65 3000 "25 25" "45 35" "60 50" "75 75" "85 100"
log "done"
