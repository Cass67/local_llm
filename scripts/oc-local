#!/usr/bin/env bash
# oc-local: central launcher for local LLMs via llama.cpp.
#
# Usage:
#   oc-local [family] [profile] [--dry-run] [--info] [--lean] [--no-ssh] [--quiet] [--] [extra-args...]
#   oc-local list-profiles
#   oc-local show <family:profile>
#   oc-local last-runs [N]
#
# Examples:
#   oc-local qwen reliable
#   oc-local qwen-coder reliable --lean
#   oc-local list-profiles
#   oc-local show qwen:reliable
#   oc-local last-runs 5

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
source "$SCRIPT_DIR/lib.sh"

ensure_dirs

# Argument parsing
DRY_RUN=false
INFO_ONLY=false
LEAN=false
NO_SSH=false
QUIET=false
EXTRA_ARGS=()

MODE="run"
SUBCMD_ARG1=""
SUBCMD_ARG2=""

parse_args() {
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      list-profiles)
        MODE="list-profiles"
        return
        ;;
      show)
        MODE="show"
        SUBCMD_ARG1="${2:-}"
        return
        ;;
      last-runs)
        MODE="last-runs"
        SUBCMD_ARG1="${2:-10}"
        return
        ;;
      --dry-run)
        DRY_RUN=true
        shift
        ;;
      --info)
        INFO_ONLY=true
        shift
        ;;
      --lean)
        LEAN=true
        shift
        ;;
      --no-ssh)
        NO_SSH=true
        shift
        ;;
      --quiet)
        QUIET=true
        shift
        ;;
      --)
        shift
        EXTRA_ARGS+=("$@")
        return
        ;;
      -*)
        # Treat unknown flags as extra args for llama-server
        EXTRA_ARGS+=("$1")
        shift
        ;;
      *)
        args+=("$1")
        shift
        ;;
    esac
  done

  # MODE is "run", interpret positional args as:
  # - [family] [profile], or
  # - family:profile
  local first="${args[0]:-}"
  local second="${args[1]:-}"

  if [[ "$first" == *:* && -z "$second" ]]; then
    # family:profile
    SUBCMD_ARG1="${first%%:*}"
    SUBCMD_ARG2="${first#*:}"
  else
    SUBCMD_ARG1="$first"
    SUBCMD_ARG2="$second"
  fi
}

parse_args "$@"

# Subcommands

mode_list_profiles() {
  require_jq
  local profiles
  profiles="$(list_profiles)"

  if [[ -z "$profiles" ]]; then
    log_error "No profiles found in $PROFILES_JSON"
    exit 1
  fi

  echo "Available profiles (family:profile):"
  echo "$profiles" | while IFS= read -r p; do
    local family profile_name
    family="$(echo "$p" | cut -d: -f1)"
    profile_name="$(echo "$p" | cut -d: -f2)"
    local flags=""
    if [[ "$profile_name" == "reliable" ]]; then flags=" [stable]"; fi
    if [[ "$profile_name" == "speed" ]]; then flags=" [fast]"; fi
    if [[ "$profile_name" == "tiny" ]]; then flags=" [small]"; fi
    echo "  ${BOLD}${p}${RESET}${flags}"
  done
}

mode_show() {
  local key="$SUBCMD_ARG1"
  [[ -n "$key" ]] || die "Usage: oc-local show <family:profile>"

  local profile
  profile="$(get_profile "$key")"
  if [[ -z "$profile" ]]; then
    die "Unknown profile: $key"
  fi

  echo "Profile: $key"
  echo "$profile" | jq .
}

mode_last_runs() {
  local n="${SUBCMD_ARG1:-10}"
  if [[ ! -d "$RUNS_DIR" ]]; then
    log_info "No runs directory found."
    return
  fi

  local files
  files="$(find "$RUNS_DIR" -name '*.json' -type f | sort -r | head -n "$n")"
  if [[ -z "$files" ]]; then
    log_info "No recent runs found."
    return
  fi

  echo "Last $n run(s):"
  while IFS= read -r f; do
    local summary
    summary="$(jq -r '
      "\(.profile) \(.phase) at \(.timestamp) \(.stop_time // "")"
    ' "$f" 2>/dev/null || echo "$f")"
    echo "  $summary"
  done <<< "$files"
}

# Main run mode

mode_run() {
  local family="$SUBCMD_ARG1"
  local profile_name="$SUBCMD_ARG2"

  # If called via symlink (e.g., oc-qwen-reliable), try to extract family and profile.
  if [[ -z "$family" || -z "$profile_name" ]]; then
    if $INFO_ONLY; then
      # Allow: ./oc-local --info without family/profile
      :
    else
      local base
      base="$(basename "$0")"
      # Only treat as symlink-style if it is NOT "oc-local" itself
      # Pattern: oc-<family>-<profile>
      if [[ "$base" == oc-* && "$base" != "oc-local" ]]; then
        local suffix="${base#oc-}"
        local first_dash
        first_dash="${suffix%%-*}"
        local rest="${suffix#*-}"
        if [[ -n "$first_dash" && -n "$rest" && "$first_dash" != "$rest" ]]; then
          family="$first_dash"
          profile_name="$rest"
        else
          die "Could not infer family/profile from: $base"
        fi
      else
        die "Usage: oc-local [family] [profile] [--dry-run|--info|--lean|--no-ssh|--quiet|--] [extra-args...]"
      fi
    fi
  fi

  # Info-only mode (can be global or per-profile)
  if $INFO_ONLY; then
    if [[ -z "$family" || -z "$profile_name" ]]; then
      # Global info: list all profiles with short description
      echo "Available models (profiles):"
      echo ""

      local profiles
      profiles="$(list_profiles)"

      echo "$profiles" | while IFS= read -r p; do
        local family profile_name model_name context batch ubatch quant
        family="$(echo "$p" | cut -d: -f1)"
        profile_name="$(echo "$p" | cut -d: -f2)"

        local profile_json
        profile_json="$(jq -r --arg k "$p" '.profiles[$k]' "$PROFILES_JSON" 2>/dev/null)"

        model_name="$(echo "$profile_json" | jq -r '.model_name // ""')"
        context="$(echo "$profile_json" | jq -r '.context // ""')"
        batch="$(echo "$profile_json" | jq -r '.batch // ""')"
        ubatch="$(echo "$profile_json" | jq -r '.ubatch // ""')"
        quant="$(echo "$profile_json" | jq -r '.quant // ""')"

        local short
        short="$(printf "%s (%s) ctx=%s batch=%s" "$model_name" "$profile_name" "$context" "$batch")"

        echo "  ${BOLD}$p${RESET} $short"
      done
    else
      # Single profile info
      local profile_key="${family}:${profile_name}"
      local profile
      profile="$(get_profile "$profile_key")"
      if [[ -z "$profile" ]]; then
        die "Unknown profile: $profile_key"
      fi
      echo "Profile: $profile_key"
      echo "$profile" | jq .
      echo "LLAMA_SERVER_BIN: $LLAMA_SERVER_BIN"
      echo "REMOTE_HOST: ${REMOTE_HOST:-<not set>}"
    fi
    return
  fi

  # For non-info modes, require family/profile
  if [[ -z "$family" || -z "$profile_name" ]]; then
    die "Usage: oc-local [family] [profile] [--dry-run|--info|--lean|--no-ssh|--quiet|--] [extra-args...]"
  fi

  local profile_key="${family}:${profile_name}"
  local profile
  profile="$(get_profile "$profile_key")"
  if [[ -z "$profile" ]]; then
    die "Unknown profile: $profile_key"
  fi

  # Build command from profile
  local cmd_line
  cmd_line="$(echo "$profile" | build_llama_cmd "${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"}")"

  if $DRY_RUN; then
    echo "DRY-RUN: would execute:"
    echo "$cmd_line"
    return
  fi

  # Observability: record start
  local run_file
  run_file="$(write_run_metadata "$profile_key" "start")"

  # Run model (local or remote)
  if $QUIET; then
    if $NO_SSH || [[ -z "$REMOTE_HOST" ]]; then
      eval "$cmd_line" >/dev/null 2>&1 &
    else
      ssh_run "cd \"\$HOME/local_llm\" && $cmd_line" >/dev/null 2>&1 &
    fi
  else
    log_info "Starting profile $profile_key"
    log_info "Run metadata: $run_file"
    if $NO_SSH || [[ -z "$REMOTE_HOST" ]]; then
      eval "$cmd_line" &
    else
      ssh_run "cd \"\$HOME/local_llm\" && $cmd_line" &
    fi
    local pid=$!
    log_info "llama-server PID: $pid"
  fi
}

case "$MODE" in
  list-profiles) mode_list_profiles ;;
  show) mode_show ;;
  last-runs) mode_last_runs ;;
  run) mode_run ;;
esac
