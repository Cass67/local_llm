{
	auto_https off
}

:3001 {
	# OpenCode web upstream is proxied by the switcher service for injection.
	handle /api/local-llm/* {
		reverse_proxy 127.0.0.1:3003
	}

	handle /_switcher {
		reverse_proxy 127.0.0.1:3003
	}

	# OpenCode WebSocket upgrades bypass injection and go directly upstream.
	handle /ws/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /pty/*/connect {
		reverse_proxy 127.0.0.1:3002
	}

	handle {
		reverse_proxy 127.0.0.1:3003
	}
}
