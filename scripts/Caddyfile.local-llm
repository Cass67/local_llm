{
	auto_https off
}

:3001 {
	# Container API and UI routes
	handle /api/local-llm/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /ui/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:3100
	}

	# Chat shell with guaranteed back link; iframe hosts Open WebUI.
	handle /chat* {
		header Content-Type text/html
		respond "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>local_llm Chat</title><style>body{margin:0;background:#0b0f14;color:#e5e7eb;font-family:system-ui,sans-serif}.bar{height:44px;display:flex;align-items:center;gap:1rem;padding:0 1rem;background:#111827;border-bottom:1px solid #263244}.bar a{color:#93c5fd;text-decoration:none;font-weight:600}iframe{display:block;width:100%;height:calc(100vh - 45px);border:0}</style></head><body><div class=\"bar\"><a href=\"/ui/\">← Back to local_llm</a><span>Open WebUI</span></div><iframe src=\"/\" title=\"Open WebUI\"></iframe></body></html>" 200
	}

	# Open WebUI app. Its built SPA expects root-level routing.
	handle / {
		reverse_proxy 127.0.0.1:3101
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_app/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /manifest.json {
		reverse_proxy 127.0.0.1:3101
	}

	handle /favicon* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_socket/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_switcher {
		reverse_proxy 127.0.0.1:3100
	}

	# OpenCode WebSocket upgrades bypass injection and go directly upstream.
	handle /ws/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /pty/*/connect {
		reverse_proxy 127.0.0.1:3002
	}

	# Fallback: Open WebUI client-side routes expect root-level routing.
	handle {
		reverse_proxy 127.0.0.1:3101
	}
}
