{
	auto_https off
}

:3001 {
	# Container API and UI routes
	handle /api/local-llm/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /ui/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /_switcher {
		reverse_proxy 127.0.0.1:3100
	}

	# Proxy chat completions through container to llama-server
	handle /api/chat/* {
		reverse_proxy 127.0.0.1:3100
	}

	# Log streaming
	handle /api/logs/* {
		reverse_proxy 127.0.0.1:3100
	}

	# OpenCode WebSocket upgrades bypass injection and go directly upstream.
	handle /ws/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /pty/*/connect {
		reverse_proxy 127.0.0.1:3002
	}

	# Fallback: everything else to the old switcher (for now)
	handle {
		reverse_proxy 127.0.0.1:3003
	}
}
