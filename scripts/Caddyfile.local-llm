{
	auto_https off
}

:3001 {
	# Container API and UI routes
	handle /api/local-llm/logs/stream* {
		reverse_proxy 127.0.0.1:3100 {
			flush_interval -1
		}
	}

	handle /api/local-llm/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /ui {
		redir * /ui/ permanent
	}

	handle /ui/* {
		reverse_proxy 127.0.0.1:3100
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:3200
	}

	# Chat shell with guaranteed back link; iframe hosts Open WebUI. The iframe
	# must load the real root path -- Open WebUI's client router 404s on any
	# rewritten path -- so it uses /?chat=1 and the root handler branches on it.
	handle /chat* {
		header Content-Type text/html
		respond "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>local_llm Chat</title><style>html,body{margin:0;height:100%;background:#0b0f14;color:#e5e7eb;font-family:system-ui,sans-serif;overflow:hidden}.bar{height:40px;display:flex;align-items:center;gap:.75rem;padding:0 .75rem;background:#111827;border-bottom:1px solid #263244;box-sizing:border-box}.bar a{color:#93c5fd;text-decoration:none;font-weight:600}iframe{display:block;width:100%;height:calc(100vh - 40px - max(10px,env(safe-area-inset-bottom)));height:calc(100dvh - 40px - max(10px,env(safe-area-inset-bottom)));border:0;padding-bottom:max(10px,env(safe-area-inset-bottom));box-sizing:border-box}@media(max-width:700px){.bar{height:36px;font-size:13px}iframe{height:calc(100vh - 36px - max(14px,env(safe-area-inset-bottom)));height:calc(100dvh - 36px - max(14px,env(safe-area-inset-bottom)));padding-bottom:max(14px,env(safe-area-inset-bottom))}}</style></head><body><div class=\"bar\"><a href=\"/ui/\">← Back to local_llm</a><span>Open WebUI</span></div><iframe src=\"/?chat=1\" title=\"Open WebUI\"></iframe></body></html>" 200
	}

	# Management UI is public default. Open WebUI remains available under /chat/.
	handle / {
		route {
			@chat query chat=1
			reverse_proxy @chat 127.0.0.1:3101
			redir * "/ui/#/architecture" temporary
		}
	}

	handle /static/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_app/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /manifest.json {
		reverse_proxy 127.0.0.1:3101
	}

	handle /favicon* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_socket/* {
		reverse_proxy 127.0.0.1:3101
	}

	handle /_switcher {
		reverse_proxy 127.0.0.1:3100
	}

	# pi coding agent. ttyd serves its own /pi base path (-b /pi), so no rewrite.
	# Routed here so pi works through the cloudflared tunnel: Cloudflare only
	# proxies a fixed set of ports, so a host:3006 link hangs from outside.
	handle /pi {
		redir * /pi/ permanent
	}

	handle /pi/* {
		reverse_proxy 127.0.0.1:3006
	}

	# opencode TUI, served by ttyd under its own /opencode base path.
	handle /opencode {
		redir * /opencode/ permanent
	}

	handle /opencode/* {
		reverse_proxy 127.0.0.1:3002
	}

	# OpenCode 2 beta, same ttyd shape under its own /opencode2 base path. Distinct
	# first path segment from /opencode, so the matchers above never catch it.
	handle /opencode2 {
		redir * /opencode2/ permanent
	}

	handle /opencode2/* {
		reverse_proxy 127.0.0.1:3009
	}

	# Open WebUI Socket.IO uses /ws/socket.io; route it before generic OpenCode /ws.
	handle /ws/socket.io* {
		reverse_proxy 127.0.0.1:3101
	}

	# OpenCode WebSocket upgrades bypass injection and go directly upstream.
	handle /ws/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /socket.io/* {
		reverse_proxy 127.0.0.1:3002
	}

	handle /pty/*/connect {
		reverse_proxy 127.0.0.1:3002
	}

	# Langfuse is built with NEXT_PUBLIC_BASE_PATH=/traces, so keep prefix intact.
	handle /traces {
		redir * /traces/ temporary
	}

	handle /traces/* {
		reverse_proxy 127.0.0.1:3004
	}

	# Grafana runs with GF_SERVER_ROOT_URL/serve_from_sub_path set to /metrics,
	# so like Langfuse it wants the prefix left on.
	handle /metrics {
		redir * /metrics/ temporary
	}

	handle /metrics/* {
		reverse_proxy 127.0.0.1:3007
	}

	# Fallback: Open WebUI client-side routes expect root-level routing.
	handle {
		reverse_proxy 127.0.0.1:3101
	}
}
