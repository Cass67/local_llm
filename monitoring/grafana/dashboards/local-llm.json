    {
      "id": 9,
      "type": "timeseries",
      "title": "Parallelism (GPU-equivalents)",
      "description": "Concurrent GPU-equivalents of work from DRM fdinfo. Flat at 1.0 on a 2-card runner means the split is serialized \u2014 the second card is buying nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_runner_gpu_equiv",
          "legendFormat": "{{cluster}} ({{split_mode}})"
