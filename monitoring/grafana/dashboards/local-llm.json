{
  "uid": "local-llm-overview",
  "title": "local_llm \u2014 inference & GPUs",
  "tags": [
    "local-llm"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "runner",
        "label": "Runner",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(llamacpp:requests_processing, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Inference",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Generation",
      "description": "Tokens generated per second of generation time. Divided by llama.cpp's own generation-seconds counter, not wall clock, so idle gaps between requests do not drag it down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llamacpp:tokens_predicted_total{instance=~\"$runner\"}[1m])) / sum(rate(llamacpp:tokens_predicted_seconds_total{instance=~\"$runner\"}[1m]))",
          "legendFormat": "tok/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "noValue": "idle"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Prompt",
      "description": "Prompt tokens processed per second of prompt-processing time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llamacpp:prompt_tokens_total{instance=~\"$runner\"}[1m])) / sum(rate(llamacpp:prompt_seconds_total{instance=~\"$runner\"}[1m]))",
          "legendFormat": "tok/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d95926"
          },
          "noValue": "idle"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(llamacpp:requests_processing{instance=~\"$runner\"})",
          "legendFormat": "processing"
        },
        {
          "refId": "B",
          "expr": "sum(llamacpp:requests_deferred{instance=~\"$runner\"})",
          "legendFormat": "queued"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "palette-classic-by-name"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Draft acceptance",
      "description": "Speculative-decode tokens accepted as a share of tokens drafted. Pooled over tokens, so a request that drafted two does not weigh the same as one that drafted a thousand.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(llamacpp:spec_decode_num_accepted_tokens_total{instance=~\"$runner\"}[5m])) / sum(rate(llamacpp:spec_decode_num_draft_tokens_total{instance=~\"$runner\"}[5m]))",
          "legendFormat": "accepted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#d95926",
                "value": null
              },
              {
                "color": "#c98500",
                "value": 40
              },
              {
                "color": "#199e70",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Runner up",
      "description": "Scrape health per runner port. A cluster that is not loaded scrapes down, which is expected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"llama-runner\"})",
          "legendFormat": "runners"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#199e70"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "textMode": "value_and_name",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Generation throughput",
      "description": "Per runner. Compare against GPU busy below: high busy with low tok/s is a memory-bound or serialized split, not a loaded machine.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:tokens_predicted_total{instance=~\"$runner\"}[1m]) / rate(llamacpp:tokens_predicted_seconds_total{instance=~\"$runner\"}[1m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Prompt throughput",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_total{instance=~\"$runner\"}[1m]) / rate(llamacpp:prompt_seconds_total{instance=~\"$runner\"}[1m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Draft acceptance",
      "description": "Accepted / drafted over time. Falls off a cliff when the draft model desyncs \u2014 the DFlash long-context failure mode.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(llamacpp:spec_decode_num_accepted_tokens_total{instance=~\"$runner\"}[5m]) / rate(llamacpp:spec_decode_num_draft_tokens_total{instance=~\"$runner\"}[5m])",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "palette-classic-by-name"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "barchart",
      "title": "Acceptance by draft position",
      "description": "Chance a drafted token survives at each position, per draft. Where this hits the floor is where extra draft depth stops paying \u2014 the number --spec-draft-n-max should be set from.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (position) (rate(llamacpp:spec_decode_num_accepted_tokens_per_pos_total{instance=~\"$runner\"}[15m])) / scalar(sum(rate(llamacpp:spec_decode_num_drafts_total{instance=~\"$runner\"}[15m])))",
          "legendFormat": "{{position}}",
          "format": "time_series",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [
              "lastNotNull"
            ]
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Field",
                "desc": false
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "GPUs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "collapsed": false
    },
