      },
      "targets": [
        {
          "refId": "A",
          "expr": "llm_gpu_power_watts",
          "legendFormat": "{{pci}} {{board}}"
        },
        {
          "refId": "B",
          "expr": "llm_gpu_power_cap_watts",
          "legendFormat": "{{pci}} cap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "min": 0,
