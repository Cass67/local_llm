# Copy to .env and adjust for your system.
# All values shown are the defaults — only set what differs.

# User/group that the management container runs as.
# Match your host UID/GID: id -u / id -g
LOCAL_LLM_UID=1000
LOCAL_LLM_GID=1000

# Render group for GPU access (/dev/dri). Find with: getent group render | cut -d: -f3
RENDER_GROUP=991

# Where accepted model metadata, state files, and the benchmark database live.
LOCAL_LLM_STATE_DIR=${HOME}/.local/share/local_llm

# HuggingFace GGUF cache. Shared between management downloads and the runner mount.
HF_CACHE_DIR=${HOME}/.cache/huggingface/hub

# Runner image to use when launching models.
RUNNER_IMAGE=local-llm-runner:latest

# Port the runner container listens on.
LLAMA_SERVER_PORT=8080

# Path to the Caddyfile (defaults to the checked-in one).
# LOCAL_LLM_CADDYFILE=./scripts/Caddyfile.local-llm

# Langfuse secrets (required; compose refuses to start without them).
# Generate with: openssl rand -hex 32. SALT hashes Langfuse API keys: changing it
# invalidates every existing key. The DB password only applies on a fresh volume;
# for an existing one, also run ALTER USER langfuse WITH PASSWORD '...'.
LANGFUSE_DB_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Grafana admin (required). Only seeds a fresh grafana volume; for an existing one run
# grafana cli admin reset-admin-password --password-from-stdin inside the container.
GRAFANA_ADMIN_PASSWORD=
