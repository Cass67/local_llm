+    for(int i=0;i<64;++i){
+        for(size_t v=0;v<V;++v){float a=reference_logits[(size_t)i*V+v],b=lg[v];
+            if(!std::isfinite(a)||!std::isfinite(b)){err="nonfinite parity logits";return false;}
