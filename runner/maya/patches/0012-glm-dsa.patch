+    if (a.ik_raw != nullptr) a.ik_raw += (size_t) t * a.idx_key;
+    if (blockIdx.x == 0) {   // qr = rms(qr_raw) * w, and its q8_1
+        if (a.qr_raw == nullptr) return;   // a batched NextN cache fill needs only the latent/k_pe
+        float ss = 0.0f;
+        for (int e = tid; e < a.q_lora; e += blockDim.x) ss += a.qr_raw[e] * a.qr_raw[e];
+        const float inv = rsqrtf(block_sum(ss, sred) / (float) a.q_lora + a.eps);
+        for (int e = tid; e < a.q_lora; e += blockDim.x) {
+            const float xv = a.qr_raw[e] * inv * a.q_a_norm[e];
+            a.qr[e] = xv;
+            if (a.qr_q != nullptr) q8_1_store_warp(xv, (block_q8_1*) a.qr_q + e / 32, lane);
+            if (a.qr16 != nullptr) a.qr16[e] = __half_as_ushort(__float2half(xv));
+        }
+    } else if (blockIdx.x == 1) {   // the latent (normed, FP16 cache row p) and k_pe (roped, NOT normed, F32 row p)
+        if (a.kv_raw == nullptr) return;   // (mistral-large4: this layer reads another layer's KV)
+        float ss = 0.0f;
+        for (int e = tid; e < a.kv_lora; e += blockDim.x) ss += a.kv_raw[e] * a.kv_raw[e];
+        const float inv = rsqrtf(block_sum(ss, sred) / (float) a.kv_lora + a.eps);
+        if (a.rec > 0) {   // one record a position, into each target (identity / host copy / resident slot)
+            uint16_t* tg[3];
+            int nt = 0;
+            if (a.lat != nullptr) tg[nt++] = a.lat + (size_t) a.p * a.rec;
+            if (a.lat_host != nullptr) tg[nt++] = a.lat_host + (size_t) a.p * a.rec;
+            if (a.lat_slots != nullptr && a.lat_table != nullptr) {
+                const int sl = a.lat_table[a.p / a.lat_page];
+                if (sl >= 0) tg[nt++] = a.lat_slots + ((size_t) sl * a.lat_page + a.p % a.lat_page) * a.rec;
+            }
+            for (int e = tid; e < a.kv_lora; e += blockDim.x) {
+                const uint16_t h = __half_as_ushort(__float2half(a.kv_raw[e] * inv * a.kv_norm[e]));
+                for (int k = 0; k < nt; ++k) tg[k][e] = h;
+            }
+            if (tid < a.n_rot / 2) {
+                float y0, y1;
+                rope_pair(a.kv_raw[a.kv_lora + 2 * tid], a.kv_raw[a.kv_lora + 2 * tid + 1], tid, a.n_rot, a.p, a.base, y0, y1, a.rx);
+                for (int k = 0; k < nt; ++k) {
+                    float* kp = (float*) (tg[k] + a.kv_lora);
+                    kp[2 * tid] = y0;
+                    kp[2 * tid + 1] = y1;
+                }
+            }
+            return;
+        }
+        for (int e = tid; e < a.kv_lora; e += blockDim.x)
+            a.lat[(size_t) a.p * a.kv_lora + e] = __half_as_ushort(__float2half(a.kv_raw[e] * inv * a.kv_norm[e]));
+        if (tid < a.n_rot / 2) {
+            float y0, y1;
+            rope_pair(a.kv_raw[a.kv_lora + 2 * tid], a.kv_raw[a.kv_lora + 2 * tid + 1], tid, a.n_rot, a.p, a.base, y0, y1, a.rx);
+            a.kpe[(size_t) a.p * a.n_rot + 2 * tid] = y0;
+            a.kpe[(size_t) a.p * a.n_rot + 2 * tid + 1] = y1;
+        }
+    } else if (a.ik_raw != nullptr) {   // the indexer key: layer norm (w, b), roped on its first n_rot dims -> row p
+        const int n = a.idx_key;
+        float sum = 0.0f;
+        for (int e = tid; e < n; e += blockDim.x) sum += a.ik_raw[e];
+        const float mu = block_sum(sum, sred) / (float) n;
+        float var = 0.0f;
+        for (int e = tid; e < n; e += blockDim.x) var += (a.ik_raw[e] - mu) * (a.ik_raw[e] - mu);
+        const float inv = rsqrtf(block_sum(var, sred) / (float) n + a.ln_eps);
+        for (int e = tid; e < n; e += blockDim.x) sy[e] = (a.ik_raw[e] - mu) * inv * a.k_norm_w[e] + a.k_norm_b[e];
+        __syncthreads();
+        float* row = a.ik + (size_t) a.p * n;
+        if (tid < a.n_rot / 2) {
+            float y0, y1;
+            rope_pair(sy[2 * tid], sy[2 * tid + 1], tid, a.n_rot, a.p, a.base, y0, y1, a.rx);
+            row[2 * tid] = y0;
+            row[2 * tid + 1] = y1;
+        }
+        for (int e = a.n_rot + tid; e < n; e += blockDim.x) row[e] = sy[e];
+    }
+}
+
+__global__ void __launch_bounds__(1024) layer_norm_row_kernel(const float* __restrict__ x, const float* __restrict__ w,
+                                                               const float* __restrict__ b, int n, float eps,
+                                                               float* __restrict__ y) {
+    __shared__ float sred[32];
+    const int tid = threadIdx.x;
+    x += (size_t) blockIdx.x * n;
+    y += (size_t) blockIdx.x * n;
+    float sum = 0.0f;
+    for (int e = tid; e < n; e += blockDim.x) sum += x[e];
+    const float mu = block_sum(sum, sred) / (float) n;
+    float var = 0.0f;
+    for (int e = tid; e < n; e += blockDim.x) var += (x[e] - mu) * (x[e] - mu);
+    const float inv = rsqrtf(block_sum(var, sred) / (float) n + eps);
+    for (int e = tid; e < n; e += blockDim.x) y[e] = (x[e] - mu) * inv * w[e] + b[e];
+}
+
+__global__ void softcap_kernel(float* __restrict__ x, int n, float cap) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) x[i] = tanhf(x[i] / cap) * cap;
+}
+
+__global__ void ssmax_heads_kernel(float* __restrict__ x, int width, int stride, int n_head, const float* __restrict__ sw,
+                                   const float* __restrict__ sb, int pos, int ld) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= n_head * width) return;
+    const int h = idx / width;
+    const float lp = (float) (log((double) (pos + (int) blockIdx.y) + 1.0) + 1.0) - 1.0f;
+    x[(size_t) ld * blockIdx.y + (size_t) stride * h + idx % width] *= lp * sw[h] + sb[h];
+}
+
+__global__ void rope_heads_kernel(float* __restrict__ x, int n_rot, int stride, int n_head, int pos, float base,
+                                  int ld, RopeExt rx) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= n_head * (n_rot / 2)) return;
+    const int h = idx / (n_rot / 2), i = idx % (n_rot / 2);
+    pos += blockIdx.y;
+    float* xh = x + (size_t) ld * blockIdx.y + (size_t) stride * h + 2 * i;
+    float y0, y1;
+    rope_pair(xh[0], xh[1], i, n_rot, pos, base, y0, y1, rx);
+    xh[0] = y0;
+    xh[1] = y1;
+}
+
+// q_abs[h][c] = sum_e wk_b[h][c][e] * q_nope[h][e]   (wk_b BF16 {qk_nope, kv_lora, n_head}; q heads k_mla apart)
+// q_nope of every head, packed: qn[h][e] = q[k_mla * h + e]
+__global__ void pack_q_nope_kernel(const float* __restrict__ q, int k_mla, int qk_nope, float* __restrict__ qn) {
+    for (int e = threadIdx.x; e < qk_nope; e += blockDim.x) qn[(size_t) qk_nope * blockIdx.x + e] = q[(size_t) k_mla * blockIdx.x + e];
+}
+
+__global__ void mla_pe_qabs_kernel(const float* __restrict__ q, int k_mla, int qk_nope, const uint16_t* __restrict__ wk_b,
+                                   int kv_lora, int n_head, float* __restrict__ q_abs) {
+    const int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= kv_lora * n_head) return;
+    const int h = idx / kv_lora, c = idx % kv_lora;
+    const uint16_t* w = wk_b + (size_t) qk_nope * c + (size_t) qk_nope * kv_lora * h;
+    const float* qh = q + (size_t) k_mla * h;
+    float acc = 0.0f;
+    for (int e = 0; e < qk_nope; ++e) acc += bf(w[e]) * qh[e];
+    q_abs[idx] = acc;
+}
+
+// one block a head: scores (q_abs . latent + q_pe . k_pe) / sqrt(qk_nope + n_rot) over the cells, softmax, ctx, wv_b . ctx
+__global__ void __launch_bounds__(256) mla_pe_attend_kernel(const float* __restrict__ q_abs, const float* __restrict__ q,
+                                                            int k_mla, int qk_nope, int n_rot,
+                                                            const uint16_t* __restrict__ lat,
+                                                            const float* __restrict__ kpe, const int* __restrict__ cells,
+                                                            int n_sel, const uint16_t* __restrict__ wv_b, int kv_lora,
+                                                            int v_head, float* __restrict__ out, int lat_ld, int kpe_ld) {
+    extern __shared__ float sm[];
+    float* prob = sm;                 // n_sel
+    float* ctx = sm + n_sel;          // kv_lora
+    float* qa = ctx + kv_lora;        // kv_lora
+    float* qp = qa + kv_lora;         // n_rot
+    __shared__ float sred[32];
+    const int h = blockIdx.x, tid = threadIdx.x;
+    for (int c = tid; c < kv_lora; c += blockDim.x) qa[c] = q_abs[(size_t) kv_lora * h + c];
+    for (int e = tid; e < n_rot; e += blockDim.x) qp[e] = q[(size_t) k_mla * h + qk_nope + e];
+    __syncthreads();
+    const float scale = rsqrtf((float) (qk_nope + n_rot));
+    float mx = -INFINITY;
+    for (int s = tid; s < n_sel; s += blockDim.x) {
+        const int cell = cells != nullptr ? cells[s] : s;
+        const uint16_t* lr = lat + (size_t) lat_ld * cell;
+        float dot = 0.0f;
+        for (int c = 0; c < kv_lora; ++c) dot += qa[c] * __half2float(__ushort_as_half(lr[c]));
+        const float* kr = kpe + (size_t) kpe_ld * cell;
+        for (int e = 0; e < n_rot; ++e) dot += qp[e] * kr[e];
+        prob[s] = dot * scale;
+        mx = fmaxf(mx, prob[s]);
+    }
+    mx = block_max(mx, sred);
+    float sum = 0.0f;
+    for (int s = tid; s < n_sel; s += blockDim.x) {
+        prob[s] = expf(prob[s] - mx);
+        sum += prob[s];
+    }
+    const float inv = 1.0f / block_sum(sum, sred);
+    __syncthreads();
+    for (int c = tid; c < kv_lora; c += blockDim.x) {
+        float acc = 0.0f;
+        for (int s = 0; s < n_sel; ++s)
+            acc += prob[s] * __half2float(__ushort_as_half(lat[(size_t) lat_ld * (cells != nullptr ? cells[s] : s) + c]));
+        ctx[c] = acc * inv;
+    }
+    __syncthreads();
+    for (int v = tid; v < v_head; v += blockDim.x) {
+        const uint16_t* w = wv_b + (size_t) kv_lora * v + (size_t) kv_lora * v_head * h;
+        float acc = 0.0f;
+        for (int c = 0; c < kv_lora; ++c) acc += bf(w[c]) * ctx[c];
+        out[(size_t) v_head * h + v] = acc;
+    }
+}
+
+}  // namespace
+
+void dsa_rope_prep(const DsaRopePrepArgs& a, cudaStream_t s) {
+    dsa_rope_prep_kernel<<<dim3(a.ik_raw != nullptr ? 3 : 2, (unsigned) a.T), 1024, 0, s>>>(a);
+    launch_check("dsa_rope_prep");
+}
+
+void rope_heads(float* x, int n_rot, int stride, int n_head, int pos, float base, cudaStream_t s, int T, int ld,
+                const RopeExt& rx) {
+    const int n = n_head * (n_rot / 2);
+    rope_heads_kernel<<<dim3((n + 255) / 256, (unsigned) T), 256, 0, s>>>(x, n_rot, stride, n_head, pos, base, ld, rx);
+    launch_check("rope_heads");
+}
+
+void softcap(float* x, int n, float cap, cudaStream_t s) {
+    softcap_kernel<<<(n + 255) / 256, 256, 0, s>>>(x, n, cap);
+    launch_check("softcap");
+}
+
+void layer_norm_row(const float* x, const float* w, const float* b, int n, float eps, float* y, cudaStream_t s, int T) {
+    layer_norm_row_kernel<<<T, 1024, 0, s>>>(x, w, b, n, eps, y);
+    launch_check("layer_norm_row");
+}
+
+void ssmax_heads(float* x, int width, int stride, int n_head, const float* s_w, const float* s_b, int pos,
+                 cudaStream_t s, int T, int ld) {
+    const int n = n_head * width;
+    ssmax_heads_kernel<<<dim3((n + 255) / 256, (unsigned) T), 256, 0, s>>>(x, width, stride, n_head, s_w, s_b, pos, ld);
+    launch_check("ssmax_heads");
+}
+
+void mla_pe(const float* q, int k_mla, int qk_nope, int n_rot, const uint16_t* wk_b, const uint16_t* wv_b,
+            const uint16_t* lat, const float* kpe, const int* cells, int n_sel, int n_head, int kv_lora, int v_head,
+            float* scratch, void* out_q8_1, cudaStream_t s, int lat_ld, int kpe_ld) {
+    if (lat_ld <= 0) lat_ld = kv_lora;
+    if (kpe_ld <= 0) kpe_ld = n_rot;
+    // Flash's decode structure (mla): wk_b . q_nope by warp-per-row GEMVs, the attention split over cell chunks and
+    // head groups (mla_split_kernel + the q_pe . k_pe term) and merged, wv_b . ctx into q8_1.  STRATA_GLM_MLA_PE_NAIVE=1:
+    // the one-block-a-head kernels below (the parity reference)
+    static const bool naive = getenv("STRATA_GLM_MLA_PE_NAIVE") != nullptr;
+    int dev = 0;
+    cudaGetDevice(&dev);
+    if (!naive && dev < 16 && kv_lora <= 512 && kv_lora % 32 == 0 && v_head % 32 == 0 && n_head <= 128) {
+        static float* buf[16] = {};
+        static int attr[16] = {};
+        const size_t smem = (size_t) MLA_CHUNK * kv_lora * sizeof(uint16_t) + (size_t) MLA_HPB * MLA_CHUNK * sizeof(float);
+        if (attr[dev] < (int) smem) {
+            if (cudaFuncSetAttribute(mla_split_kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, (int) smem) == cudaSuccess)
+                attr[dev] = (int) smem;
+            else
+                cudaGetLastError();
+        }
+        if (buf[dev] == nullptr &&
+            cudaMalloc(&buf[dev], (size_t) n_head * (2 * kv_lora + k_mla) * sizeof(float)) != cudaSuccess) {   // (k_mla: a NoPE layer packs the whole head)
+            buf[dev] = nullptr;
+            cudaGetLastError();
+        }
+        const int n_chunks = (n_sel + MLA_CHUNK - 1) / MLA_CHUNK;
+        int cap = 0;
+        float* part = buf[dev] != nullptr && attr[dev] >= (int) smem ? mla_part(dev, n_head, kv_lora, n_chunks, &cap) : nullptr;
+        if (part != nullptr && cap >= n_chunks) {
+            float* q_abs = buf[dev];
+            float* ctx = q_abs + (size_t) n_head * kv_lora;
+            float* qn = ctx + (size_t) n_head * kv_lora;
+            pack_q_nope_kernel<<<n_head, 256, 0, s>>>(q, k_mla, qk_nope, qn);
+            headwise_gemv_kernel<<<n_head * kv_lora / 32, 256, 0, s>>>(wk_b, qn, kv_lora, qk_nope, q_abs, nullptr);
+            mla_split_kernel<<<dim3(n_chunks, (n_head + MLA_HPB - 1) / MLA_HPB), 256, smem, s>>>(
+                q_abs, lat, cells, n_sel, n_head, qk_nope, kv_lora, part, false, lat_ld, q + qk_nope, k_mla, kpe, kpe_ld,
+                n_rot, 1.0f / std::sqrt((float) (qk_nope + n_rot)));
+            mla_combine_kernel<<<n_head, 256, 0, s>>>(part, n_chunks, n_head, kv_lora, ctx);
+            headwise_gemv_kernel<<<n_head * v_head / 32, 256, 0, s>>>(wv_b, ctx, v_head, kv_lora, nullptr,
+                                                                      (block_q8_1*) out_q8_1);
+            launch_check("mla_pe split");
+            return;
+        }
+    }
+    float* q_abs = scratch;
+    float* out = scratch + (size_t) n_head * kv_lora;
+    mla_pe_qabs_kernel<<<(kv_lora * n_head + 255) / 256, 256, 0, s>>>(q, k_mla, qk_nope, wk_b, kv_lora, n_head, q_abs);
+    launch_check("mla_pe_qabs");
+    const size_t smem = ((size_t) n_sel + 2 * kv_lora + n_rot) * sizeof(float);
+    mla_pe_attend_kernel<<<n_head, 256, smem, s>>>(q_abs, q, k_mla, qk_nope, n_rot, lat, kpe, cells, n_sel, wv_b,
+                                                   kv_lora, v_head, out, lat_ld, kpe_ld);
+    launch_check("mla_pe_attend");
+    strata::kernels::quantize_q8_1_rows(out, 1, (int64_t) n_head * v_head, out_q8_1, s);
+}
+
 }  // namespace strata::kernels::glmf
