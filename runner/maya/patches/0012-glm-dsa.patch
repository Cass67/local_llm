+        CHECK(hipMemcpy(got.data(), dy, got.size() * sizeof(float), hipMemcpyDeviceToHost));
+        double worst = 0;
+        for (int t = 0; t < T; ++t) {
+            double ss = 0;
+            for (int e = 0; e < E; ++e) ss += double(x[t * E + e]) * x[t * E + e];
+            for (int e = 0; e < E; ++e) {
