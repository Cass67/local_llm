+            nullptr, temp_storage_bytes, x, keys_out, indices_in, dst,
+            ncols, 0, sizeof(float) * 8, stream));
+    }
+
+    ggml_cuda_pool_alloc<uint8_t> temp_storage_alloc(pool, temp_storage_bytes);
+    void * temp_storage = temp_storage_alloc.get();
+
+    for (int row = 0; row < nrows; ++row) {
+        init_indices<<<grid_size, block_size, 0, stream>>>(indices_in, ncols, 1);
+        CUDA_CHECK(cudaGetLastError());
+
+        if (order == GGML_SORT_ORDER_ASC) {
+            CUDA_CHECK(hipcub::DeviceRadixSort::SortPairs(
+                temp_storage, temp_storage_bytes, x + row * ncols, keys_out,
+                indices_in, dst + row * ncols, ncols, 0, sizeof(float) * 8, stream));
+        } else {
+            CUDA_CHECK(hipcub::DeviceRadixSort::SortPairsDescending(
+                temp_storage, temp_storage_bytes, x + row * ncols, keys_out,
+                indices_in, dst + row * ncols, ncols, 0, sizeof(float) * 8, stream));
+        }
+    }
+}
