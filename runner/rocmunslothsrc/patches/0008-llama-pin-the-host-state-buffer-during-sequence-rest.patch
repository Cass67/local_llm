From 4457f5c4ed3745f6725c22aaddde21b48e044688 Mon Sep 17 00:00:00 2001
From: Cass <getcass@gmail.com>
Date: Sat, 12 Sep 2026 13:20:24 +0100
Subject: [PATCH] llama: pin the host state buffer during sequence restore

Works around a ROCm runtime defect: an async H2D copy whose source is pageable
host memory faults when 2+ devices are active in one process.

  ROCm/rocm-systems#4817, ggml-org/llama.cpp#20176, #26828 (closed as #4817)

llama_context::state_seq_set_data hands `src` to llama_io_read_host, which
defers its ggml_backend_tensor_set calls to its destructor; those are async H2D
DMAs reading straight out of `src`. On a multi-GPU HIP build that faults:

  amdgpu ... [gfxhub] page fault (src_id:0 ring:24 vmid:8)
  Memory access fault by GPU node-N ... Page not present or supervisor privilege

Registering the buffer takes it off the pageable path. Measured upstream by
davetha (2x MI210): fault after 2 restores -> 140 restores over 12 rounds clean.
Measured here (4x 7900 XT gfx1100, layer split, 4 devices in one process): 3
faults and 3 restarts inside one stress round unpatched, while --cache-ram 0 and
--ctx-checkpoints 0 each ran clean -- both of those avoid the fault by removing
restores entirely, which is the thing this pins instead of removing.

This is the single choke point for BOTH restore routes, the server prompt cache
and the --ctx-checkpoints path, so one site covers both. Patching the individual
call sites is how you get a false negative: pin one, exercise the other,
conclude it did not help.

ggml_backend_cuda_{register,unregister}_host_buffer already exist with exactly
the right flags (Portable|ReadOnly) and are exported through the backend
registry, so the call site stays backend-agnostic -- it resolves at runtime and
no-ops on backends that do not provide the pair. Their
getenv("GGML_CUDA_REGISTER_HOST") gate is dropped because it made both functions
unconditional no-ops and nothing else in the tree calls either one (only the
CUDA and SYCL backends define them; there are zero callers), so this call site
is the entire blast radius.
---
 ggml/src/ggml-cuda/ggml-cuda.cu |  8 ------
 src/llama-context.cpp           | 51 +++++++++++++++++++++++++++++++++
 2 files changed, 51 insertions(+), 8 deletions(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5ae3b8d..f784fd1 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -4828,10 +4828,6 @@ void ggml_backend_cuda_get_device_memory(int device, size_t * free, size_t * tot
 }
 
 bool ggml_backend_cuda_register_host_buffer(void * buffer, size_t size) {
-    if (getenv("GGML_CUDA_REGISTER_HOST") == nullptr) {
-        return false;
-    }
-
 #if CUDART_VERSION >= 11010 || defined(GGML_USE_MUSA) || defined(GGML_USE_HIP)
     cudaError_t err = cudaHostRegister(buffer, size, cudaHostRegisterPortable | cudaHostRegisterReadOnly);
     if (err != cudaSuccess) {
@@ -4851,10 +4847,6 @@ bool ggml_backend_cuda_register_host_buffer(void * buffer, size_t size) {
 }
 
 void ggml_backend_cuda_unregister_host_buffer(void * buffer) {
-    if (getenv("GGML_CUDA_REGISTER_HOST") == nullptr) {
-        return;
-    }
-
     cudaError_t err = cudaHostUnregister(buffer);
     if (err != cudaSuccess) {
         // clear the error
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 6334f3c..cf062c5 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1,6 +1,7 @@
 #include "llama-context.h"
 
 #include "ggml.h"
+#include "ggml-backend.h"
 #include "llama-arch.h"
 #include "llama-graph.h"
 #include "llama-impl.h"
@@ -3098,7 +3099,57 @@ size_t llama_context::state_seq_get_data(llama_seq_id seq_id, uint8_t * dst, siz
     }
 }
 
+// ROCm runtime defect ROCm/rocm-systems#4817: an async H2D copy whose source is pageable host
+// memory faults when 2+ devices are active in one process. The restore below defers its
+// ggml_backend_tensor_set calls to llama_io_read_host's destructor, and those DMAs read out of
+// `src`, so take `src` off the pageable path for as long as they may be in flight.
+//
+// Resolved through the backend registry rather than called directly: this translation unit is
+// backend-agnostic, and a backend that does not export the pair leaves the buffer unpinned,
+// which is the pre-patch behaviour.
+namespace {
+
+struct llama_state_host_pin {
+    void * ptr = nullptr;
+    void (*unreg)(void *) = nullptr;
+
+    llama_state_host_pin(const uint8_t * src, size_t size) {
+        if (src == nullptr || size == 0) {
+            return;
+        }
+
+        for (size_t i = 0; i < ggml_backend_reg_count(); i++) {
+            ggml_backend_reg_t reg = ggml_backend_reg_get(i);
+
+            auto reg_fn = (bool (*)(void *, size_t)) ggml_backend_reg_get_proc_address(
+                    reg, "ggml_backend_register_host_buffer");
+            auto unreg_fn = (void (*)(void *)) ggml_backend_reg_get_proc_address(
+                    reg, "ggml_backend_unregister_host_buffer");
+
+            if (reg_fn != nullptr && unreg_fn != nullptr &&
+                reg_fn(const_cast<uint8_t *>(src), size)) {
+                ptr   = const_cast<uint8_t *>(src);
+                unreg = unreg_fn;
+                break;
+            }
+        }
+    }
+
+    ~llama_state_host_pin() {
+        if (ptr != nullptr && unreg != nullptr) {
+            unreg(ptr);
+        }
+    }
+
+    llama_state_host_pin(const llama_state_host_pin &) = delete;
+    llama_state_host_pin & operator=(const llama_state_host_pin &) = delete;
+};
+
+}
+
 size_t llama_context::state_seq_set_data(llama_seq_id seq_id, const uint8_t * src, size_t size, llama_state_seq_flags flags) {
+    const llama_state_host_pin pin(src, size);
+
     std::unique_ptr<llama_io_read_i> io;
     if (flags & LLAMA_STATE_SEQ_FLAGS_ON_DEVICE) {
         // create a temporary io to read the magic and the src seq_id
