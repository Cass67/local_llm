+@lru_cache(maxsize=1)
+def is_rdna_supported():
+    """Whether the device is an AMD RDNA GPU (consumer Radeon, wave32).
+
+    Covers gfx11xx (RDNA3/3.5) and gfx12xx (RDNA4). False on every non-HIP
+    build, so callers do not need their own is_hip().
+    """
+    if torch.version.hip:
+        gcn_arch = torch.cuda.get_device_properties(0).gcnArchName
+        return any(gfx in gcn_arch for gfx in ["gfx11", "gfx12"])
+    else:
+        return False
+
